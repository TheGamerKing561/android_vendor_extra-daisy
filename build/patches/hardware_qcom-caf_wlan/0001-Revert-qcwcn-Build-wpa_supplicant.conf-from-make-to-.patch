From b0dbad2e431dc55132ab03dd4276736a41b0c182 Mon Sep 17 00:00:00 2001
From: backslashxx <118538522+backslashxx@users.noreply.github.com>
Date: Fri, 30 Jan 2026 18:01:21 +0800
Subject: [PATCH] Revert "qcwcn: Build wpa_supplicant.conf from make to soong"

This reverts commit 7f9322199834cb2335cd3e4843ec0cfeca9b3168.
---
 Android.mk              | 10 ++++++++++
 qcwcn/Android.mk        |  6 ++++++
 qcwcn/config/Android.bp | 23 -----------------------
 qcwcn/config/Android.mk | 25 +++++++++++++++++++++++++
 4 files changed, 41 insertions(+), 23 deletions(-)
 create mode 100644 Android.mk
 create mode 100644 qcwcn/Android.mk
 delete mode 100644 qcwcn/config/Android.bp
 create mode 100644 qcwcn/config/Android.mk

diff --git a/Android.mk b/Android.mk
new file mode 100644
index 0000000..3c542ca
--- /dev/null
+++ b/Android.mk
@@ -0,0 +1,10 @@
+ifeq ($(call my-dir),$(call project-path-for,qcom-wlan))
+
+# TODO:  Find a better way to separate build configs for ADP vs non-ADP devices
+QCOM_WLAN_ROOT := $(call my-dir)
+
+ifneq ($(BOARD_IS_AUTOMOTIVE),true)
+include $(call all-subdir-makefiles)
+endif
+
+endif
diff --git a/qcwcn/Android.mk b/qcwcn/Android.mk
new file mode 100644
index 0000000..be3bb25
--- /dev/null
+++ b/qcwcn/Android.mk
@@ -0,0 +1,6 @@
+# adp8064 and fox box do not share wifi code
+ifeq ($(filter adp8064 fox,$(TARGET_DEVICE)),)
+  ifeq ($(BOARD_WLAN_DEVICE),qcwcn)
+    include $(call all-subdir-makefiles)
+  endif
+endif
diff --git a/qcwcn/config/Android.bp b/qcwcn/config/Android.bp
deleted file mode 100644
index a0f4eb5..0000000
--- a/qcwcn/config/Android.bp
+++ /dev/null
@@ -1,23 +0,0 @@
