-// limitations under the License.
-
-prebuilt_etc {
-    name: "wpa_supplicant.conf",
-    src: ":wpa_supplicant_conf_gen",
-    sub_dir: "wifi",
-    vendor: true,
-    licenses: [
-        "external_wpa_supplicant_8_license",
-    ],
-}
diff --git a/qcwcn/config/Android.mk b/qcwcn/config/Android.mk
new file mode 100644
index 0000000..b99f4ac
--- /dev/null
+++ b/qcwcn/config/Android.mk
@@ -0,0 +1,25 @@
