From fb692c751d5d7f9de32f21e7d9014b4d4657d1d9 Mon Sep 17 00:00:00 2001
From: KanadeAlt <enashinonome264@gmail.com>
Date: Mon, 29 Sep 2025 19:48:29 +0000
Subject: [PATCH 2/4] Revert "qcom: Remove more obsolete board flags"

This reverts commit dacf91affba45f57af875d6d7048c486dfbe447c.
---
 BoardConfigQcom.mk | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/BoardConfigQcom.mk b/BoardConfigQcom.mk
index 95c73ae..00d9434 100644
--- a/BoardConfigQcom.mk
+++ b/BoardConfigQcom.mk
@@ -274,6 +274,17 @@ endif
 # Tell HALs that we're compiling an AOSP build with an in-line kernel
 TARGET_COMPILE_WITH_MSM_KERNEL := true
 
+# Enable media extensions
+TARGET_USES_MEDIA_EXTENSIONS := true
+
+# Allow building audio encoders
+TARGET_USES_QCOM_MM_AUDIO := true
+
+# Enable color metadata on UM platforms that support it
+ifneq ($(filter msm8937 msm8953 msm8996,$(TARGET_BOARD_PLATFORM)),)
+    TARGET_USES_COLOR_METADATA := true
+endif
+
 # Enable DRM PP driver on UM platforms that support it
 ifneq ($(filter $(UM_4_9_FAMILY) $(UM_4_14_FAMILY) $(UM_4_19_FAMILY) $(UM_5_4_FAMILY) $(UM_5_10_FAMILY) $(UM_5_15_FAMILY) $(UM_6_1_FAMILY) $(UM_6_6_FAMILY),$(TARGET_BOARD_PLATFORM)),)
     SOONG_CONFIG_qtidisplay_drmpp := true
-- 
